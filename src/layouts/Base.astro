---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute path, e.g. "/tools/puppy-growth-calculator". */
  path?: string;
  /** JSON-LD graph entries, merged into the page graph. */
  schema?: Array<Record<string, unknown>>;
  /** 'website' for the home page, 'article' for guides. */
  ogType?: 'website' | 'article';
  /** Set to false to hide the global header (e.g. on a share/print view). */
  showHeader?: boolean;
}

const {
  title,
  description,
  path = '/',
  schema = [],
  ogType = 'website',
  showHeader = true,
} = Astro.props;

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://petcalc.io';
const BRAND = 'PetCalc';
const url = SITE + path;

/**
 * Brand suffix is appended only when the page title does not already contain
 * it. Titles are kept under 60 characters including the suffix — PROJECT.md
 * §6.2 / §8 publish gate.
 */
const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;

const breadcrumbs = [
  { name: 'Home', item: SITE + '/' },
  ...(path !== '/' ? [{ name: title.split('|')[0].trim(), item: url }] : []),
];

const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    url,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    publisher: {
      '@type': 'Organization',
      name: BRAND,
      url: SITE,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.item,
    })),
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#b8541f" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={SITE + '/og-default.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + '/og-default.png'} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>
  <body>
    {
      showHeader && (
        <header class="border-b border-hairline bg-surface">
          <div class="shell flex h-16 items-center justify-between gap-4">
            <a href="/" class="flex items-center gap-2 no-underline">
              <span class="font-display text-xl font-semibold tracking-tight text-ink">
                PetCalc
              </span>
              <span class="hidden text-xs text-mute sm:inline">
                breed-aware pet calculators
              </span>
            </a>
            <nav aria-label="Primary" class="flex items-center gap-1 text-sm">
              <a href="/tools/" class="rounded-full px-3 py-1.5 text-body hover:bg-canvas-2">
                Tools
              </a>
              <a href="/breeds/" class="rounded-full px-3 py-1.5 text-body hover:bg-canvas-2">
                Breeds
              </a>
              <a
                href="/methodology/"
                class="rounded-full px-3 py-1.5 text-body hover:bg-canvas-2"
              >
                Methodology
              </a>
            </nav>
          </div>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-hairline bg-surface">
      <div class="shell py-12">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="font-display text-lg font-semibold">PetCalc</p>
            <p class="mt-2 text-sm text-body">
              Free, source-cited calculators for dog and cat growth, feeding and age —
              built on a breed-level dataset.
            </p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-mute">Calculators</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="/tools/puppy-growth-calculator/">Puppy growth calculator</a></li>
              <li><a href="/tools/puppy-weight-calculator/">Puppy weight calculator</a></li>
              <li><a href="/tools/dog-food-calculator/">Dog food calculator</a></li>
            </ul>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-mute">Dataset</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="/breeds/">Breed profiles</a></li>
              <li><a href="/methodology/">How we calculate</a></li>
              <li><a href="/methodology/#sources">Sources</a></li>
            </ul>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-mute">Legal</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="/disclaimer/">Disclaimer</a></li>
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </div>
        </div>

        <p class="mt-10 border-t border-hairline pt-6 text-xs leading-relaxed text-mute">
          <strong>Disclaimer:</strong> PetCalc provides educational estimates for
          informational purposes only and is not veterinary advice. Always confirm
          feeding amounts and growth expectations with your own veterinarian.
        </p>
      </div>
    </footer>
  </body>
</html>
