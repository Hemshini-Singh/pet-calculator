---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Absolute path, e.g. "/calculators/dog-bcs/". */
  path?: string;
  /** JSON-LD graph entries, merged into the page graph. */
  schema?: Array<Record<string, unknown>>;
  /** 'website' for home/indexes, 'article' for guides/calculators. */
  ogType?: 'website' | 'article';
  showHeader?: boolean;
}

const {
  title,
  description,
  path = '/',
  schema = [],
  ogType = 'website',
  showHeader = true,
} = Astro.props;

const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://petconditionscore.com';
const BRAND = 'Pet Condition Score';
const url = SITE + path;

const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;

const breadcrumbs = [
  { name: 'Home', item: SITE + '/' },
  ...(path !== '/' ? [{ name: title.split('|')[0].trim(), item: url }] : []),
];

const graph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    publisher: {
      '@type': 'Organization',
      name: BRAND,
      url: SITE,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.item,
    })),
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#1B4332" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={SITE + '/og-default.png'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + '/og-default.png'} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  </head>
  <body>
    {
      showHeader && (
        <header class="sticky top-0 z-30 border-b border-hairline bg-canvas/95 backdrop-blur-sm">
          <div class="shell flex h-16 items-center justify-between gap-4">
            <a href="/" class="flex items-center gap-2.5 no-underline">
              <span
                class="flex h-7 w-7 items-center justify-center rounded-md bg-brand font-mono text-xs font-semibold text-white"
                aria-hidden="true"
              >
                PCS
              </span>
              <span class="font-display text-lg font-medium tracking-tight text-ink sm:text-xl">
                Pet Condition Score
              </span>
            </a>

            <nav aria-label="Primary" class="hidden items-center gap-1 text-sm md:flex">
              <a
                href="/calculators/"
                class="rounded-md px-3 py-1.5 text-body no-underline transition hover:bg-canvas-2 hover:text-ink"
              >
                All Calculators
              </a>
              <a
                href="/calculators/dog-bcs/"
                class="rounded-md px-3 py-1.5 text-body no-underline transition hover:bg-canvas-2 hover:text-ink"
              >
                Dog BCS
              </a>
              <a
                href="/calculators/cat-bmi/"
                class="rounded-md px-3 py-1.5 text-body no-underline transition hover:bg-canvas-2 hover:text-ink"
              >
                Cat BMI
              </a>
              <a
                href="/calculators/dog-pregnancy/"
                class="rounded-md px-3 py-1.5 text-body no-underline transition hover:bg-canvas-2 hover:text-ink"
              >
                Pregnancy
              </a>
              <a
                href="/methodology/"
                class="rounded-md px-3 py-1.5 text-body no-underline transition hover:bg-canvas-2 hover:text-ink"
              >
                Methodology
              </a>
            </nav>

            <div class="flex items-center gap-2">
              <div
                class="inline-flex rounded-md border border-hairline bg-canvas-2 p-0.5 text-xs"
                role="group"
                aria-label="Global unit system"
              >
                <button
                  type="button"
                  data-global-unit="metric"
                  class="rounded px-2.5 py-1 font-mono font-medium transition cursor-pointer"
                >
                  kg/cm
                </button>
                <button
                  type="button"
                  data-global-unit="imperial"
                  class="rounded px-2.5 py-1 font-mono font-medium transition cursor-pointer"
                >
                  lb/in
                </button>
              </div>
              <a
                href="/calculators/"
                class="rounded-md border border-hairline bg-surface px-2.5 py-1.5 text-xs font-medium text-ink no-underline hover:bg-canvas-2 md:hidden"
              >
                Tools
              </a>
            </div>
          </div>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-hairline bg-surface-dark text-white">
      <div class="shell py-14">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <p class="font-display text-lg font-medium text-white">Pet Condition Score</p>
            <p class="mt-2.5 text-sm leading-relaxed text-zinc-400">
              Clinically-informed pet health calculators and veterinary condition references.
              Built on WSAVA, NRC (2006), and published morphometric formulas.
            </p>
            <p class="mt-4 font-mono text-xs text-zinc-500">petconditionscore.com</p>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-zinc-400">Body & Nutrition</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a href="/calculators/dog-bcs/" class="text-zinc-300 no-underline hover:text-white">
                  Dog BCS &amp; BMI Calculator
                </a>
              </li>
              <li>
                <a href="/calculators/cat-bmi/" class="text-zinc-300 no-underline hover:text-white">
                  Cat BMI (FBMI) Calculator
                </a>
              </li>
              <li>
                <a href="/calculators/pet-calorie-calculator/" class="text-zinc-300 no-underline hover:text-white">
                  Daily Calorie &amp; Food Calculator
                </a>
              </li>
            </ul>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-zinc-400">Pregnancy & Growth</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a href="/calculators/dog-pregnancy/" class="text-zinc-300 no-underline hover:text-white">
                  Dog Pregnancy Timeline
                </a>
              </li>
              <li>
                <a href="/calculators/cat-pregnancy/" class="text-zinc-300 no-underline hover:text-white">
                  Cat Pregnancy Timeline
                </a>
              </li>
              <li>
                <a href="/calculators/gestational-week/" class="text-zinc-300 no-underline hover:text-white">
                  Gestational Week Calculator
                </a>
              </li>
              <li>
                <a href="/calculators/puppy-growth-calculator/" class="text-zinc-300 no-underline hover:text-white">
                  Puppy Weight Predictor
                </a>
              </li>
            </ul>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-zinc-400">Reference</p>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a href="/calculators/" class="text-zinc-300 no-underline hover:text-white">
                  All Calculators
                </a>
              </li>
              <li>
                <a href="/calculators/pet-age-converter/" class="text-zinc-300 no-underline hover:text-white">
                  Pet Age Converter
                </a>
              </li>
              <li>
                <a href="/methodology/" class="text-zinc-300 no-underline hover:text-white">
                  Methodology &amp; Citations
                </a>
              </li>
            </ul>
          </div>
        </div>

        <p class="mt-10 border-t border-zinc-800 pt-6 text-xs leading-relaxed text-zinc-400">
          <strong class="text-zinc-200">Veterinary &amp; Medical Disclaimer:</strong> Pet Condition
          Score provides educational estimates derived from published veterinary and clinical
          literature for informational purposes only. It is not a substitute for professional
          veterinary or medical examination, diagnosis, or treatment.
        </p>
      </div>
    </footer>

    <script>
      import { getUnitSystem, setUnitSystem, type UnitSystem } from '../scripts/petProfile';

      function syncGlobalUnitButtons() {
        const current = getUnitSystem();
        document.querySelectorAll<HTMLButtonElement>('[data-global-unit]').forEach((btn) => {
          const isActive = btn.dataset.globalUnit === current;
          btn.classList.toggle('bg-surface', isActive);
          btn.classList.toggle('text-ink', isActive);
          btn.classList.toggle('shadow-xs', isActive);
          btn.classList.toggle('text-mute', !isActive);
        });
      }

      syncGlobalUnitButtons();
      document.querySelectorAll<HTMLButtonElement>('[data-global-unit]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = btn.dataset.globalUnit as UnitSystem;
          if (next === 'metric' || next === 'imperial') {
            setUnitSystem(next);
            syncGlobalUnitButtons();
          }
        });
      });
      window.addEventListener('pcs:unit-change', syncGlobalUnitButtons);
    </script>
  </body>
</html>
