---
import Base from '../layouts/Base.astro';
import { liveTools } from '../data/tools';
import { BREEDS, publishableBreeds } from '../data/breeds';

const title = 'Breed-Aware Pet Calculators';
const description =
  'Free, source-cited calculators for dog and cat growth, feeding and age. Built on a breed-level dataset of 300+ breeds using WSAVA growth curves and NRC energy formulas.';

const tools = liveTools();
const published = publishableBreeds();
const totalBreeds = BREEDS.length;
---

<Base title={title} description={description} path="/">
  <section class="shell pt-14 pb-10 md:pt-20 md:pb-14">
    <p class="font-mono text-xs uppercase tracking-widest text-brand">
      Breed-aware pet calculators
    </p>
    <h1 class="mt-4 max-w-3xl text-balance">
      The calculator that knows your dog’s breed.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-body">
      Generic calculators answer a generic question. Ours uses a breed-level dataset —
      adult weight ranges, growth curves, lifespan, body condition and health constraints —
      so the answer is specific to <em>your</em> animal. Every formula is named, every
      figure is cited.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#calculators"
        class="inline-flex items-center rounded-full bg-brand px-6 py-3 text-sm font-medium text-white no-underline transition hover:bg-brand-deep"
      >
        Browse the calculators
      </a>
      <a
        href="/methodology/"
        class="inline-flex items-center rounded-full border border-hairline-strong bg-surface px-6 py-3 text-sm font-medium text-ink no-underline transition hover:bg-canvas-2"
      >
        See how we calculate
      </a>
    </div>
  </section>

  <section id="calculators" class="shell py-12">
    <h2 class="text-2xl">Calculators</h2>
    {
      tools.length === 0 ? (
        <div class="mt-6 rounded-lg border border-dashed border-hairline-strong bg-surface p-8 text-center">
          <p class="text-body">
            The first calculators are being built. The breed dataset that powers them is
            already in progress.
          </p>
        </div>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}/`}
                class="block h-full rounded-lg border border-hairline bg-surface p-5 no-underline transition hover:border-brand"
              >
                <h3 class="text-lg leading-snug">{tool.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-body">{tool.blurb}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="border-y border-hairline bg-surface py-14">
    <div class="shell grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <h2>The dataset is the product.</h2>
        <p class="mt-4 leading-relaxed text-body">
          Every calculator on this site reads from one breed database: adult weight
          ranges for males and females, growth curves by size class, energy requirements,
          expected lifespan, ideal body condition score and breed-specific health
          constraints. It is the reason our answers are specific — and the reason a
          generic calculator cannot copy them.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-body">
          <li class="flex gap-3">
            <span class="font-mono text-brand">01</span>
            <span>
              <strong class="text-ink">Growth curves</strong> from WSAVA
              (Flohr et al., 2018), applied by size class.
            </span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-brand">02</span>
            <span>
              <strong class="text-ink">Energy requirements</strong> from NRC
              (2006), Nutrient Requirements of Dogs and Cats.
            </span>
          </li>
          <li class="flex gap-3">
            <span class="font-mono text-brand">03</span>
            <span>
              <strong class="text-ink">Body condition scoring</strong> on the
              WSAVA 1–9 scale, breed-aware for obesity-prone breeds.
            </span>
          </li>
        </ul>
      </div>

      <div class="rounded-lg border border-hairline bg-canvas p-6">
        <p class="font-mono text-xs uppercase tracking-wider text-mute">Dataset status</p>
        <p class="mt-3 font-display text-4xl font-semibold text-ink">
          {totalBreeds}
          <span class="text-lg font-normal text-body">breeds mapped</span>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-body">
          {published.length} of {totalBreeds} entries have been human-verified against
          their sources and are cleared for publication. We publish only what has been
          checked.
        </p>
        <div class="mt-5 h-2 overflow-hidden rounded-full bg-canvas-2">
          <div
            class="h-full rounded-full bg-brand"
            style={`width:${Math.round((published.length / Math.max(totalBreeds, 1)) * 100)}%`}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="shell py-14">
    <h2>Why a breed-level answer?</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-lg border border-hairline bg-surface p-5">
        <h3 class="text-base">Size changes everything</h3>
        <p class="mt-2 text-sm leading-relaxed text-body">
          A 4 kg Chihuahua and a 45 kg Great Dane are the same age but metabolically
          and developmentally worlds apart. Our growth curves are size-class specific.
        </p>
      </div>
      <div class="rounded-lg border border-hairline bg-surface p-5">
        <h3 class="text-base">Body condition beats the bag</h3>
        <p class="mt-2 text-sm leading-relaxed text-body">
          Feeding charts tell you what to feed a breed. Body condition score tells you
          what <em>this</em> animal needs. We ask for both.
        </p>
      </div>
      <div class="rounded-lg border border-hairline bg-surface p-5">
        <h3 class="text-base">Breeds carry constraints</h3>
        <p class="mt-2 text-sm leading-relaxed text-body">
          Brachycephalic breeds overheat. Frenchies gain weight easily. Large breeds
          need controlled growth. That context changes the recommendation.
        </p>
      </div>
    </div>
  </section>
</Base>
